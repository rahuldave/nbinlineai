{
  "title": "nbinlineai",
  "description": "AI prompt cell settings. API credentials are read only by the Jupyter server from its environment.",
  "type": "object",
  "properties": {
    "defaultBackend": {
      "type": "string",
      "title": "Default provider",
      "enum": ["openai_api", "anthropic_api"],
      "default": "openai_api"
    },
    "backendModels": {
      "type": "object",
      "title": "Model for each API provider (blank uses server default)",
      "properties": {
        "openai_api": {"type": "string", "default": ""},
        "anthropic_api": {"type": "string", "default": ""}
      },
      "additionalProperties": false,
      "default": {"openai_api": "", "anthropic_api": ""}
    },
    "maxToolSteps": {
      "type": "integer",
      "title": "Maximum tool steps",
      "minimum": 0,
      "maximum": 10,
      "default": 5
    }
  },
  "additionalProperties": false
}
